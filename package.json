{
  "name": "plantrip-mcp-server",
  "version": "1.0.1",
  "mcpName": "io.plantrip/plantrip",
  "description": "MCP Server for Plantrip - Create AI-powered travel itineraries, packing lists, weather insights, and more via Claude Desktop or any MCP client",
  "main": "dist/index.js",
  "bin": {
    "plantrip-mcp-server": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "plantrip",
    "travel",
    "itinerary",
    "packing-list",
    "claude",
    "ai",
    "anthropic",
    "travel-planning"
  ],
  "author": "Plantrip <support@plantrip.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/klabianco/plantrip-mcp-server.git"
  },
  "homepage": "https://plantrip.io/developers",
  "bugs": {
    "url": "https://github.com/klabianco/plantrip-mcp-server/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
